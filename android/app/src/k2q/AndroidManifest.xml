<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:glEsVersion="0x00030000"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera.any"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <application
        android:name="android.app.Application"
        android:label="VN97 K2Q Evidence"
        tools:replace="android:name,android:label">

        <activity
            android:name=".VN97PaperTradingActivity"
            tools:node="remove" />
        <activity
            android:name=".VN97CapabilityAcquisitionActivity"
            tools:node="remove" />
        <activity
            android:name=".VN97SelfImprovementActivity"
            tools:node="remove" />
        <activity
            android:name=".VN97MainActivity"
            tools:node="remove" />

        <service
            android:name=".VN97PaperTradingJobService"
            tools:node="remove" />
        <service
            android:name=".VN97ScreenCaptureService"
            tools:node="remove" />
        <service
            android:name="ai.vn97.platform.VN97GameAccessibilityService"
            tools:node="remove" />
        <service
            android:name=".VN97GameAgentService"
            tools:node="remove" />
        <service
            android:name=".VN97FloatingAssistantService"
            tools:node="remove" />
        <service
            android:name="ai.vn97.platform.VN97ContinuationJobService"
            tools:node="remove" />

        <receiver
            android:name=".VN97TurnkeyAcceptanceReceiver"
            tools:node="remove" />
        <receiver
            android:name=".VN97FloatingAssistantBootReceiver"
            tools:node="remove" />

        <activity
            android:name=".VN97R2OrtEvidenceActivity"
            android:exported="true"
            android:label="VN97 K2Q Evidence"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
